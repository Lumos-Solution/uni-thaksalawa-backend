# Secrets used to sign and verify JWTs. Generate your own values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-me-with-a-different-long-random-string

# Token lifetimes (any value the `ms` library understands).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Port the API listens on.
PORT=3000

# MongoDB connection string. With auth enabled, put the credentials in the
# userinfo section and URL-encode any special characters in the password:
#   mongodb://user:pass@localhost:27017/uni-thaksalawa?authSource=admin
# Atlas looks like:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/uni-thaksalawa?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/uni-thaksalawa
